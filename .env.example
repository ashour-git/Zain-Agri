# ---------------------------------------------------------------------------
# ZAIN AGRI — environment template
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Backend ---------------------------------------------------------------
# Runtime role: NON-superuser, so PostgreSQL Row Level Security is enforced.
DATABASE_URL=postgresql+psycopg://zain_app:zain_dev_only@127.0.0.1:5433/zain_agri

# Owner role: used only by Alembic migrations.
MIGRATION_DATABASE_URL=postgresql+psycopg://zain@127.0.0.1:5433/zain_agri

# Tests run against this database name, derived from the two URLs above.
TEST_DATABASE_NAME=zain_agri_test

ENVIRONMENT=development
LOG_LEVEL=INFO
DB_ECHO=false

# Explicit allow-list. Comma separated, no wildcards.
CORS_ORIGINS=http://localhost:3000

# --- Frontend --------------------------------------------------------------
# The browser calls this app's own /api/*, which Next.js proxies to API_ORIGIN
# (apps/web/next.config.ts). Keeps the refresh cookie same-site. Set these in
# apps/web/.env.local (or the Vercel project), not here: Next.js reads env
# files from apps/web.
# API_ORIGIN=http://localhost:8000
# Leave NEXT_PUBLIC_API_BASE_URL unset unless the API is on the same site.

# Shop assistant (optional). Server-side only: never prefix with NEXT_PUBLIC_.
# Leave empty to keep the assistant switched off.
GROQ_API_KEY=
# ASSISTANT_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# ASSISTANT_DAILY_LIMIT=100
